; services.rc — long-running daemons (arc init)
;
; The service executor spawns each unit after the mounts phase; units
; are started in file order and supervised (respawn policy applies).
;
; Field reference:
;   (deps A B)      — A and B must be healthy first
;   (after A)       — ordering without a hard dependency
;   (respawn ...)   — never | on-failure (default) | always
;   (ready port X)  — healthy when a service registers port X
;   (ready sleep N) — healthy N seconds after start
;   (stdio silent)  — /dev/null instead of the console

; NOTE: no (deps bootfs) here on purpose — these daemons live on the
; root fs the kernel mounted before init ran, so they must start on
; machines without extra disks too (arm64 qemu virt has no ahci0p1).

(unit driverd
  (type service)
  (exec /sbin/driverd)
  (respawn on-failure))

; Userspace PS/2 keyboard driver: owns the i8042 keyboard interface
; (ports 0x60/0x64, IRQ1) and injects decoded keys into the console tty.
(unit kbd
  (type service)
  (exec /sbin/kbd)
  (respawn on-failure))

; Userspace ATA PIO block driver: owns the legacy IDE channels
; (ports 0x1F0/0x170, IRQ14/15) and serves /dev/ataN (+MBR partitions)
; over I/O channels.
(unit ata
  (type service)
  (exec /sbin/ata)
  (respawn on-failure))

