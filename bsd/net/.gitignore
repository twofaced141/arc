# lwIP vendor — never commit upstream clutter
# Vendor script fetches and cleans; commit only the whitelist:
#   bsd/net/lwip/src/{core,api,include,netif}
#   bsd/net/lwip/COPYING, bsd/net/lwip/.vendor_rev
# Everything below is ignored to avoid accidental commit of clutter

# upstream artifacts (doc, contrib, test) - if someone extracted the full tarball
lwip/doc/
lwip/contrib/
lwip/test/
lwip/CMakeFiles/
lwip/*.html
lwip/**/*.html
lwip/**/*.sln
lwip/**/*.vcxproj
lwip/**/*.vcfilters

# temporary files
lwip/src/apps/
lwip/src/netif/ppp/
lwip/src/netif/lowpan*
